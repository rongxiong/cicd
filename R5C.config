# FriendlyARM NanoPi R5C - Lean's LEDE (coolsnowwolf/lede)
#
# This is a seed config, not a complete .config. The R5C workflow copies it
# into the LEDE tree and runs `make defconfig` to expand all defaults.
# Add/remove CONFIG_PACKAGE_* entries here to customise the firmware.

# ---------------------------------------------------------------------------
# Target: Rockchip RK3568 / armv8 / friendlyarm_nanopi-r5c
# ---------------------------------------------------------------------------
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r5c=y

# ---------------------------------------------------------------------------
# Build options
# ---------------------------------------------------------------------------
CONFIG_CCACHE=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=160

# ---------------------------------------------------------------------------
# Packages
# LuCI is already part of LEDE's default package set; keep it explicit so a
# feed change cannot silently drop the web interface.
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_tcpdump=y

# ---------------------------------------------------------------------------
# MediaTek MT7922 (Wi-Fi 6E, PCIe / M.2)
#
# LEDE has no kmod-mt7922e: mt76 handles MT7922 through the mt7921e PCIe
# driver, while MT7922 firmware lives in its own kmod package
# (WIFI_MT7922_patch_mcu_1_1_hdr.bin + WIFI_RAM_CODE_MT7922_1.bin).
# kmod-mt7921e automatically pulls in kmod-mt7921-common,
# kmod-mt792x-common, mac80211 and the MT7921/MT7961 firmware.
# Requires PCI/PCIe (rockchip/armv8 provides it) and a usable M.2 slot.
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-mt7921e=y
CONFIG_PACKAGE_kmod-mt7922-firmware=y

# Userspace: full SAE/WPA3 for 6 GHz, regulatory database, diagnostics.
# LEDE selects no wpad variant by default, so wpad-openssl is conflict-free.
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y

# MT7922 is a Wi-Fi + Bluetooth combo card. For Bluetooth, additionally
# enable mt7922bt-firmware (BT_RAM_CODE_MT7922_1_1_hdr.bin) plus
# kmod-bluetooth and a bluez userspace stack:
# CONFIG_PACKAGE_mt7922bt-firmware=y
# CONFIG_PACKAGE_kmod-bluetooth=y
